# Copy to .env and fill in.

# Postgres
DATABASE_URL="postgresql://user:password@localhost:5432/joytours?schema=public"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# OAuth providers (optional — enable in src/lib/auth.ts)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Email (Resend, SES, etc.) — for magic-link sign-in and booking confirmations
AUTH_EMAIL_SERVER=""
AUTH_EMAIL_FROM="noreply@joytour.sg"

# Stripe (phase 2 — checkout)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
